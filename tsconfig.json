{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["main.js", "src/**/*.js", "shared/**/*.mjs", "*.mjs", "src/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "vendor", "examples", "tests", "scripts", "eslint.config.mjs"]
}
